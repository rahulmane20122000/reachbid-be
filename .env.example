# ReachBid Backend Environment Secrets
# Copy this file to .env for local testing

# Razorpay Credentials (Get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_reachbid_demo
RAZORPAY_KEY_SECRET=rzp_secret_demo_key
RAZORPAY_WEBHOOK_SECRET=whsec_demo_secret

# Security Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://reachbid.lol
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
